# Copy this file to .env and replace every replace-me value before starting.
# Never commit .env. Generate a different random value for each secret.
DB_USERNAME=error_purifier
DB_PASSWORD=replace-me-with-a-strong-random-database-password
DB_ROOT_PASSWORD=replace-me-with-a-different-strong-random-root-password
ERROR_PURIFIER_ADMIN_TOKEN=replace-me-with-a-different-strong-random-admin-token

# Safe local defaults. Change the bind address only when you have added HTTPS,
# authentication/access controls, firewall rules, monitoring, and backups.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080
